# Copy this file to .env and fill in real values.
# .env itself should NEVER be committed — check .gitignore has it.

# ── Database ──────────────────────────────────────────────
# Matches docker-compose.yml's postgres service. If you're running
# Postgres some other way, adjust accordingly.
DATABASE_URL="postgresql://careerflow:careerflow_dev_only@localhost:5432/careerflow"

# ── Redis (BullMQ) ────────────────────────────────────────
# Matches docker-compose.yml's redis service.
REDIS_URL="redis://localhost:6379"

# ── Auth.js ───────────────────────────────────────────────
# Random secret used to encrypt/sign the JWT session cookie. Generate
# one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-real-random-secret"

# GitHub OAuth app credentials. Create one at:
# https://github.com/settings/developers -> "New OAuth App"
# Homepage URL: http://localhost:3000
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID="replace-me"
GITHUB_CLIENT_SECRET="replace-me"

# ── OpenTelemetry ─────────────────────────────────────────
# Where traces get sent. Defaults to a local collector if unset — only
# uncomment/change this once you actually have a collector running
# (e.g. via a separate docker-compose service, or Honeycomb/etc. in prod).
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318/v1/traces"

# ── Node ──────────────────────────────────────────────────
NODE_ENV="development"

# ── Demo user ID ─────────────────────────────────────────
DEMO_USER_ID="cmsdf86rc00006ji900i2qsrl