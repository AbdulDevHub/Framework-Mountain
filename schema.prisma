generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // Required for the similarity() function used in the match router's
  // trigram scoring — this isn't built into Postgres by default.
  // `prisma migrate dev` will run CREATE EXTENSION IF NOT EXISTS pg_trgm
  // automatically once this is here.
  extensions = [pg_trgm]
}

// ─────────────────────────────────────────────
// Auth.js models
// ─────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?

  accounts     Account[]
  jobPostings  JobPosting[]
  resumes      Resume[]
  applications Application[]
  reminderJobs ReminderJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// ─────────────────────────────────────────────
// App models
// ─────────────────────────────────────────────

model JobPosting {
  id          String   @id @default(cuid())
  userId      String
  title       String
  company     String
  description String   @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]
  matchResults MatchResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum ApplicationStatus {
  saved
  applied
  interviewing
  offer
  rejected
  withdrawn
  accepted
}

model Application {
  id           String            @id @default(cuid())
  userId       String
  jobPostingId String?
  resumeId     String?
  company      String
  role         String
  notes        String?           @db.Text
  status       ApplicationStatus @default(saved)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPosting  JobPosting? @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  resume      Resume?     @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  statusLog   StatusChange[]
  reminderJobs ReminderJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([jobPostingId])
  @@index([resumeId])
}

model StatusChange {
  id            String            @id @default(cuid())
  applicationId String
  status        ApplicationStatus
  changedAt     DateTime          @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model MatchResult {
  id           String @id @default(cuid())
  resumeId     String
  jobPostingId String

  ftsScore     Float
  trigramScore Float

  resumeUpdatedAtSnapshot     DateTime
  jobPostingUpdatedAtSnapshot DateTime

  computedAt DateTime @default(now())

  resume     Resume     @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jobPosting JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  @@index([resumeId, jobPostingId, computedAt])
}

enum ReminderStatus {
  pending
  sent
  failed
  cancelled
}

model ReminderJob {
  id            String         @id @default(cuid())
  userId        String
  applicationId String
  bullJobId     String?        @unique
  status        ReminderStatus @default(pending)
  scheduledFor  DateTime
  sentAt        DateTime?
  failureReason String?        @db.Text

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status, scheduledFor])
  @@index([applicationId])
}

model Resume {
  id     String @id @default(cuid())
  userId String
  label  String
  text   String @db.Text

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]
  matchResults MatchResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
