              "name": "avgTemp",
              "value": "={{ Math.round((($json.daily.temperature_2m_max[0] + $json.daily.temperature_2m_min[0]) / 2) * 10) / 10 }}",
              "type": "number"
            },
            {
              "id": "43dc30be-d2fc-430d-892f-691c39c9bb76",
